{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "gilead-microfrontends-root": {
      "development": {
        "fallback": "gilead-microfrontends-root.vercel.app"
      }
    },
    "gilead-microfrontends-content": {
      "routing": [
        {
          "paths": ["/_content/:path*"]
        }
      ]
    },
    "gilead-microfrontends-navigation": {
      "routing": [
        {
          "paths": ["/_navigation/:path*"]
        }
      ]
    }
  }
}